// Organization Service database. Owns organizations, departments, teams,
// memberships (userId + role within an org), and invitations. Does NOT
// own credentials (auth-service) or employee profile fields like name/job
// title (user-service) - userId here is a foreign reference to
// auth-service's User.id, but there's no cross-database FK; the id is
// just an opaque string this service trusts came from a verified JWT or
// an internal service-to-service call.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("ORGANIZATION_SERVICE_DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  teams       Team[]
  memberships Membership[]
  invitations Invitation[]

  @@map("organizations")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teams Team[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model Team {
  id             String      @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name           String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([departmentId])
  @@map("teams")
}

model Membership {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Opaque reference to auth-service's User.id - see file header note.
  userId         String
  role           String
  status         String   @default("ACTIVE") // ACTIVE | REMOVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String
  tokenHash      String    @unique
  status         String    @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@map("invitations")
}

model Branch {
  id String @id @default(uuid())
  organizationId String
  name String
  address String?
  timezone String @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("branches")
}
