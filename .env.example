# ==============================================================================
# Nexora - environment variable reference
# Copy to .env and fill in real values. Never commit a real .env file.
# Each service/app should only load the variables it actually needs
# (see packages/config), not this entire file.
# ==============================================================================

NODE_ENV=development

# ---- Postgres (Phase 2) ----
# One shared Postgres instance for local dev, one database per service
# (see infrastructure/docker/postgres/init-multiple-databases.sh).
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora
POSTGRES_DB=nexora
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Per-service connection strings (added to each service's own .env as its
# service is built - listed here as the reference for the full set).
AUTH_SERVICE_DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora_auth
ORGANIZATION_SERVICE_DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora_organization
USER_SERVICE_DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora_user
HR_SERVICE_DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora_hr
PROJECT_SERVICE_DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora_project
CRM_SERVICE_DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora_crm
FINANCE_SERVICE_DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora_finance
DOCUMENT_SERVICE_DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora_document
NOTIFICATION_SERVICE_DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora_notification
ANALYTICS_SERVICE_DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora_analytics
AUDIT_SERVICE_DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora_audit

# ---- RabbitMQ (Phase 2) ----
RABBITMQ_USER=nexora
RABBITMQ_PASSWORD=nexora
RABBITMQ_VHOST=nexora
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://nexora:nexora@localhost:5672/nexora

# ---- Redis (Phase 2) ----
REDIS_PASSWORD=nexora
REDIS_PORT=6379
REDIS_URL=redis://:nexora@localhost:6379

# ---- Auth (Phase 3) ----
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# ---- Internal service-to-service auth (Phase 4) ----
# Shared secret for calls between services that never go through the
# public gateway (e.g. auth-service -> organization-service bootstrap).
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-shared-secret

# ---- Gateway / CORS (Phase 19) ----
CORS_ORIGIN=http://localhost:5173
API_GATEWAY_PORT=4000

# ---- Service ports (dev only - each service also gets its own .env) ----
AUTH_SERVICE_PORT=4001
ORGANIZATION_SERVICE_PORT=4002
USER_SERVICE_PORT=4003
HR_SERVICE_PORT=4004
PROJECT_SERVICE_PORT=4005
CRM_SERVICE_PORT=4006
FINANCE_SERVICE_PORT=4007
DOCUMENT_SERVICE_PORT=4008
NOTIFICATION_SERVICE_PORT=4009
ANALYTICS_SERVICE_PORT=4010
AUDIT_SERVICE_PORT=4011

# ---- Document storage (Phase 9 - local now, S3-compatible later) ----
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_LOCAL_PATH=./storage/documents
DOCUMENT_MAX_UPLOAD_SIZE_MB=25

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:4000/api

# Service HTTP endpoints for local development. Compose overrides hostnames.
AUTH_SERVICE_URL=http://localhost:4001
AUTH_SERVICE_INTERNAL_URL=http://localhost:4001
ORGANIZATION_SERVICE_URL=http://localhost:4002
ORGANIZATION_SERVICE_INTERNAL_URL=http://localhost:4002
USER_SERVICE_URL=http://localhost:4003
USER_SERVICE_INTERNAL_URL=http://localhost:4003
HR_SERVICE_URL=http://localhost:4004
HR_SERVICE_INTERNAL_URL=http://localhost:4004
PROJECT_SERVICE_URL=http://localhost:4005
PROJECT_SERVICE_INTERNAL_URL=http://localhost:4005
CRM_SERVICE_URL=http://localhost:4006
CRM_SERVICE_INTERNAL_URL=http://localhost:4006
FINANCE_SERVICE_URL=http://localhost:4007
FINANCE_SERVICE_INTERNAL_URL=http://localhost:4007
DOCUMENT_SERVICE_URL=http://localhost:4008
DOCUMENT_SERVICE_INTERNAL_URL=http://localhost:4008
NOTIFICATION_SERVICE_URL=http://localhost:4009
NOTIFICATION_SERVICE_INTERNAL_URL=http://localhost:4009
ANALYTICS_SERVICE_URL=http://localhost:4010
ANALYTICS_SERVICE_INTERNAL_URL=http://localhost:4010
AUDIT_SERVICE_URL=http://localhost:4011
AUDIT_SERVICE_INTERNAL_URL=http://localhost:4011

FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Nexora <noreply@nexora.test>
