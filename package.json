{
  "name": "nexora",
  "private": true,
  "version": "0.1.0",
  "description": "Nexora - multi-tenant enterprise business management platform",
  "scripts": {
    "dev": "turbo run dev --concurrency=15",
    "build": "turbo run build --concurrency=2",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=3",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "infra:up": "docker compose up -d postgres rabbitmq redis mailpit",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down --volumes",
    "infra:logs": "docker compose logs -f postgres rabbitmq redis",
    "infra:ps": "docker compose ps",
    "check:deps": "node scripts/check-dependencies.mjs",
    "check:compose-env": "node scripts/check-compose-env.mjs",
    "check:all": "node scripts/check-dependencies.mjs && node scripts/check-compose-env.mjs",
    "seed": "pnpm --filter @nexora/seed seed",
    "test:e2e": "pnpm --filter @nexora/e2e test:e2e",
    "db:generate": "pnpm -r --if-present prisma:generate",
    "db:deploy": "node --env-file=.env scripts/run-pnpm.mjs -r --if-present prisma:deploy",
    "doctor": "node scripts/doctor.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "test:browser": "pnpm --filter @nexora/e2e test:browser",
    "api:docs": "node scripts/openapi.mjs"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "@types/node": "^22.7.4",
    "prettier": "^3.3.3",
    "eslint": "^9.11.1",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "globals": "^15.9.0",
    "@eslint/js": "9.39.5"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.19.0 <12"
  },
  "type": "module"
}
