{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "generated/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "*_SERVICE_*",
    "JWT_*",
    "REDIS_URL",
    "RABBITMQ_*",
    "INTERNAL_SERVICE_SECRET",
    "CORS_ORIGIN",
    "NEXORA_ENV_FILE",
    "SMTP_*",
    "FRONTEND_URL",
    "EVENT_OUTBOX_PATH"
  ]
}
